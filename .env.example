# Copy to .env and fill in your key (never commit .env).
# Kimi Open Platform (China): https://platform.moonshot.cn/console/api-keys

MOONSHOT_API_KEY=your_key_here
# China keys from platform.kimi.com use this address.
# International keys use https://api.moonshot.ai/v1
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# Optional server (3000 is often taken on Windows)
PORT=3001
# HOST=0.0.0.0
