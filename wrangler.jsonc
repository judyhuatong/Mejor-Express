{
  "name": "mejor-express",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "mejorexpress.com", "custom_domain": true },
    { "pattern": "www.mejorexpress.com", "custom_domain": true }
  ]
}
